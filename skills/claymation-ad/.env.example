# Fill in only what the backend you picked needs.

# Story QC (vision check on every painted frame)
CLAUDE_API_KEY=

# Images, and motion via Wan/Kling
REPLICATE_API_KEY=

# Motion via fal (Kling v3) — optional alternative to Replicate
FAL_KEY=
MOTION_PROVIDER=replicate        # or: fal

# Narration (word timestamps) and sound effects
ELEVENLABS_API_KEY=

# --- or: one inReels account instead of Replicate + fal + ElevenLabs TTS ---
# Key from inreels.ai/dashboard/settings/api-keys. CLAUDE_API_KEY is still
# needed for the vision check, and ELEVENLABS_API_KEY for sound effects.
INREELS_API_KEY=
# IMAGE_PROVIDER=inreels
# MOTION_PROVIDER=inreels
# VOICE_PROVIDER=inreels
# INREELS_MOTION_MODEL=seedance-2.0-mini-frames
